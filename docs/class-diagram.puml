@startuml

class Client {
  name : string
  last_name : string
  email : string
}

class Plan {
  name : string
  description : string
  price : float
  frequency : string
  status : string
}

class Subscription {
  date_start : date
  date_end : date
  status : string
  cancellation_requested : bool
}

class Invoice {
  broadcast : date
  expiration : date
  amount : float
  status : string
}

class Payment {
  date : date
  amount : float
  method : string
  status : string
}

Client "1" -- "0..*" Subscription
Client "1" -- "0..*" Invoice
Plan "1" -- "0..*" Subscription
Subscription "1" -- "0..1" Invoice
Invoice "1" -- "0..1" Payment

@enduml
